# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/vinylnation"

# Supabase auth
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"

# Stripe
STRIPE_PK_KEY="pk_test_..."
STRIPE_SK_KEY="sk_test_..."

# Vapi voice assistant
NUXT_PUBLIC_VAPI_TOKEN=""
NUXT_PUBLIC_VAPI_ASSISTANT_ID=""

# Kafka (optional; events are skipped when unset)
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="vinylnation-app"
KAFKA_ASSISTANT_TOPIC="assistant"
KAFKA_INVENTORY_TOPIC="inventory"
KAFKA_ORDERS_TOPIC="orders"
KAFKA_PAYMENTS_TOPIC="payments"
